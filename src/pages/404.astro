---
import BaseLayout from "../layouts/BaseLayout.astro";
import Ring from "../components/Ring.astro";
import WaveLine from "../components/WaveLine.astro";
import { t } from "../i18n/ui";
import { homePath } from "../utils/paths";
---

<BaseLayout lang="ja" page="404" bare title="SIGNAL LOST — RIPJune">
  <section class="notfound">
    <div class="notfound__ring"><Ring size={180} animated /></div>
    <p class="notfound__mono mono">SIGNAL LOST</p>
    <h1 class="notfound__jp">{t("signalLostJp", "ja")}</h1>
    <p class="notfound__line">{t("notFoundLine", "ja")}</p>
    <WaveLine class="notfound__wave" />
    <a class="notfound__back mono" href={homePath("ja")}>{t("backTop", "ja")}</a>
  </section>
</BaseLayout>
