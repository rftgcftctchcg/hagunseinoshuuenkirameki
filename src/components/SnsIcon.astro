---
interface Props {
  name: "x" | "youtube" | "niconico" | "bilibili";
  size?: number;
}

const { name, size = 18 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === "x" && <path d="M4 4 L20 20 M20 4 L4 20" />}
  {name === "youtube" && (
    <>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
      <path d="M10 9.5 L15 12 L10 14.5 Z" />
    </>
  )}
  {name === "niconico" && (
    <>
      <rect x="2.5" y="6.5" width="19" height="12" rx="3" />
      <path d="M8 15 V10 L12 15 V10" />
      <path d="M8 6.5 L6 3.5 M16 6.5 L18 3.5" />
    </>
  )}
  {name === "bilibili" && (
    <>
      <rect x="2.5" y="7" width="19" height="12" rx="3" />
      <path d="M7 7 L5 3.5 M17 7 L19 3.5" />
      <path d="M8.5 12.5 V14.5 M15.5 12.5 V14.5" />
    </>
  )}
</svg>
