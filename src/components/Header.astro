---
import { SNS_LINKS } from "../data/social";
import { t } from "../i18n/ui";
import { homePath, sectionHref } from "../utils/paths";
import type { Lang } from "../utils/paths";
import Ring from "./Ring.astro";
import SnsIcon from "./SnsIcon.astro";

interface Props {
  lang: Lang;
  page?: "home" | "detail" | "404";
}

const { lang, page = "home" } = Astro.props;
const home = homePath(lang);
const nav = [
  { id: "works", label: t("navWorks", lang) },
  { id: "profile", label: t("navProfile", lang) },
  { id: "social", label: t("navSocial", lang) },
  { id: "archive", label: t("navArchive", lang) },
];
const langs: { code: Lang; label: string }[] = [
  { code: "zh", label: "中" },
  { code: "ja", label: "日本語" },
  { code: "en", label: "EN" },
];
---

<header class="site-header" data-header data-page={page}>
  <div class="site-header__inner wrap">
    <a class="brand" href={home} aria-label="RIPJune — back to top">
      <Ring size={26} class="brand__ring" />
      <span class="brand__text display">RIPJUNE</span>
    </a>

    <nav class="site-nav" id="site-nav" data-site-nav aria-label="Main">
      {nav.map((item) => (
        <a
          class="site-nav__link mono"
          href={sectionHref(lang, item.id)}
          data-nav={item.id}
          aria-current={page === "detail" && item.id === "works" ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
      <span class="nav-indicator" data-nav-indicator aria-hidden="true"></span>
    </nav>

    <div class="site-header__tools">
      <ul class="header-sns" aria-label="SNS">
        {SNS_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="me noopener"
              aria-label={`${link.label} ${link.handle}`}
            >
              <SnsIcon name={link.key} size={16} />
            </a>
          </li>
        ))}
      </ul>

      <div class="lang-switch mono" aria-label={t("language", lang)}>
        {langs.map((item) => (
          <a
            href={homePath(item.code)}
            data-lang-link={item.code}
            class:list={[item.code === lang && "is-active"]}
            aria-current={item.code === lang ? "page" : undefined}
          >
            {item.label}
          </a>
        ))}
      </div>

      <button
        class="menu-toggle mono"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="site-nav"
      >
        {t("menu", lang)}
      </button>
    </div>
  </div>
</header>
